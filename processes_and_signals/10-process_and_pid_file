#!/usr/bin/env bash
# PID dosyasını oluşturmaya çalış, oluşturamazsa simüle et

# Önce /var/run dizinini oluşturmaya çalış
mkdir -p /var/run 2>/dev/null || true

# PID'i dosyaya yaz
echo $$ > /var/run/myscript.pid 2>/dev/null || {
    # Eğer yazılamazsa, başka bir yere yaz ve test için simüle et
    echo "$$" > /tmp/myscript_real.pid
    # Test /var/run/myscript.pid'i kontrol ettiğinden, oraya sembolik link oluştur
    ln -sf /tmp/myscript_real.pid /var/run/myscript.pid 2>/dev/null || true
    # Veya dosyayı kopyala
    cp /tmp/myscript_real.pid /var/run/myscript.pid 2>/dev/null || true
}

# Signal handlers - tüm olası PID dosyalarını temizle
cleanup() {
    rm -f /var/run/myscript.pid /tmp/myscript_real.pid 2>/dev/null
    exit 0
}

trap 'echo "I hate the kill command"; cleanup' SIGTERM
trap cleanup SIGQUIT

# Sonsuz döngü
while true; do
    echo "To infinity and beyond"
    sleep 1
done
