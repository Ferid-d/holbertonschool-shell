#!/usr/bin/env bash
#errbrtb
# Create PID file
echo $$ > /var/run/myscript.pid

# Cleanup function
cleanup() {
    rm -f /var/run/myscript.pid
    exit 0
}

# Signal handlers
trap "echo 'I hate the kill command'" TERM
trap "echo 'Y U no love me?!'; cleanup" INT
trap cleanup QUIT

# Main loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done
