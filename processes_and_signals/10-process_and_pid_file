#!/usr/bin/env bash
# This script writes its PID to a file, handles signals, and prints messages

# Farklı yerlerde dene
for pid_file in "/var/run/myscript.pid" "/tmp/myscript.pid" "./myscript.pid"; do
    if echo $$ > "$pid_file" 2>/dev/null; then
        PID_FILE="$pid_file"
        break
    fi
done

# Hiçbiri çalışmazsa, en azından geçici dosya oluştur
if [ -z "$PID_FILE" ]; then
    PID_FILE="/tmp/myscript_$$.pid"
    echo $$ > "$PID_FILE"
fi

# Handle SIGTERM
sigterm_message() {
    echo "I hate the kill command"
    rm -f "$PID_FILE" "/var/run/myscript.pid" "/tmp/myscript.pid" "./myscript.pid" 2>/dev/null
    exit 0
}

# Handle SIGQUIT
sigquit_cleanup() {
    rm -f "$PID_FILE" "/var/run/myscript.pid" "/tmp/myscript.pid" "./myscript.pid" 2>/dev/null
    exit 0
}

trap sigterm_message SIGTERM
trap sigquit_cleanup SIGQUIT

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 1
done
