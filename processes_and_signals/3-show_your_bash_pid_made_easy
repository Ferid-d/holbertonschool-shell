#!/usr/bin/env bash
#brb5btrb
for folder in /proc/*; do
    # Get just the folder name (PID)
    pid=$(basename "$folder")
    
    # Check if this is a process folder (name is a number)
    if [[ $pid =~ ^[0-9]+$ ]]; then
        # Check if the 'comm' file exists
        if [[ -f "$folder/comm" ]]; then
            # Read the process name
            process_name=$(cat "$folder/comm" 2>/dev/null)
            
            # Check if process name contains "bash" (ignore errors)
            if echo "$process_name" | grep -q "bash" 2>/dev/null; then
                # Display exactly: PID space process_name
                echo "$pid $process_name"
            fi
        fi
    fi
done
